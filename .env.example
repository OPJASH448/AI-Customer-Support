# Django Settings
SECRET_KEY=your-super-secret-key-here-change-in-production
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/customer_support

# Redis
REDIS_URL=redis://localhost:6379/0

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Google Gemini (required for RAG pipeline)
GEMINI_API_KEY=your-gemini-api-key-here

# Email Configuration (optional, update if using email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Render Environment
RENDER=false
