# Django Settings
SECRET_KEY=your-super-secret-key-here-change-in-production
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production

# Database
# Use the Supabase connection pooler URL (port 5432) for IPv4-only network compatibility (like Render free tier).
# NOTE: If your database password contains special characters like '@', they MUST be URL-encoded (e.g. '@' becomes '%40').
DATABASE_URL=postgresql://postgres.your-project-id:your-url-encoded-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Redis
# Use rediss:// (double 's') for secure TLS-enabled Redis (e.g., Upstash).
REDIS_URL=rediss://default:your-password@top-giraffe-132025.upstash.io:6379

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Google Gemini (required for RAG pipeline)
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase Storage (required for file uploads)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-secret-key
SUPABASE_BUCKET=ai-customer-support-pdfs

# Email Configuration (optional, update if using email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Render Environment
RENDER=false
